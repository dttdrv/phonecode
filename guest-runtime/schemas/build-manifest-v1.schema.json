{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dttdrv.xyz/schemas/phonecode/guest-build-manifest-v1.schema.json",
  "title": "PhoneCode guest build manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "artifacts",
    "build_epoch",
    "packages_lock_sha256",
    "protocol_version",
    "schema",
    "sources_lock_sha256",
    "system_payload",
    "toolchain_lock_sha256"
  ],
  "properties": {
    "schema": {
      "const": "phonecode-guest-build-manifest-v1"
    },
    "protocol_version": {
      "const": 1
    },
    "architecture": {
      "const": "aarch64"
    },
    "build_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "sources_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packages_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/initramfsArtifact"
        },
        {
          "$ref": "#/$defs/systemArtifact"
        },
        {
          "$ref": "#/$defs/kernelArtifact"
        }
      ],
      "items": false
    },
    "system_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "name",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "initramfsArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "name": {
              "const": "initramfs.cpio.gz"
            }
          }
        }
      ]
    },
    "systemArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "name": {
              "const": "system.img"
            }
          }
        }
      ]
    },
    "kernelArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "name": {
              "const": "vmlinuz"
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
