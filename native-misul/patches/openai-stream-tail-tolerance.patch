+    try std.testing.expectEqual(@as(u64, 3), capture.usage.input);
+    try std.testing.expectEqual(@as(u64, 4), capture.usage.output);
+    try std.testing.expectEqual(@as(u64, 7), capture.usage.total_tokens);
+
+    inline for (.{
