+        .{ .tool_result = .{ .tool_call_id = "toolu_2", .tool_name = "read_file", .content = &second_result, .is_error = true, .timestamp_ms = 0 } },
+        .{ .user = .{ .content = &next, .timestamp_ms = 0 } },
+    };
+    const lanes = [_][]const u8{ "stable", "", "session" };
