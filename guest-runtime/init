#!/bin/busybox sh
set -eu

export HOME=/root
export LANG=C
export LC_ALL=C
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TZ=UTC

BUSYBOX=/bin/busybox
NEW_ROOT=/newroot
SYSTEM_CARRIER=/run/system.carrier
SYSTEM_CARRIER_BYTES=4023808
SYSTEM_CARRIER_SHA256=3028c1fc05a52383ed0cddc535f320a285005e54ec9cd34961e94da0fc059c66
SYSTEM_PAYLOAD=/run/system.tar.gz
SYSTEM_PAYLOAD_BYTES=4023732
SYSTEM_PAYLOAD_SHA256=f55a90f69052c5bd6f92cb09a8f47065970830b194c917a006fb94028e721259
KERNEL_RELEASE=6.18.35-0-virt
CONTROL_PORT_NAME=org.phonecode.guest.0

panic() {
  console=/dev/console
  [ ! -c "$NEW_ROOT/dev/console" ] || console="$NEW_ROOT/dev/console"
  printf 'phonecode-init: %s\n' "$*" >"$console" 2>/dev/null || true
  "$BUSYBOX" poweroff -f >/dev/null 2>&1 || true
  "$BUSYBOX" halt -f >/dev/null 2>&1 || true
  while :; do
    "$BUSYBOX" sleep 3600
  done
}

"$BUSYBOX" --install -s /bin
mkdir -p /dev /proc /run /sys "$NEW_ROOT"
mount -t devtmpfs -o nosuid,noexec devtmpfs /dev || panic "cannot mount devtmpfs"
mount -t proc -o nosuid,nodev,noexec proc /proc || panic "cannot mount proc"
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys || panic "cannot mount sysfs"
mount -t tmpfs -o size=16m,nosuid,nodev tmpfs /run || panic "cannot mount runtime tmpfs"
mount -t tmpfs -o size=256m,nosuid,nodev tmpfs "$NEW_ROOT" ||
  panic "cannot mount root tmpfs"

insmod "/lib/modules/$KERNEL_RELEASE/virtio_mmio.ko" ||
  panic "cannot load virtio_mmio"
insmod "/lib/modules/$KERNEL_RELEASE/virtio_blk.ko" ||
  panic "cannot load virtio_blk"

attempt=0
while [ ! -b /dev/vda ] && [ "$attempt" -lt 100 ]; do
  sleep 0.05
  attempt=$((attempt + 1))
done
[ -b /dev/vda ] || panic "immutable system device is absent"

dd if=/dev/vda of="$SYSTEM_CARRIER" bs="$SYSTEM_CARRIER_BYTES" count=1 2>/dev/null ||
  panic "cannot read immutable system carrier"
[ "$(wc -c <"$SYSTEM_CARRIER")" -eq "$SYSTEM_CARRIER_BYTES" ] ||
  panic "immutable system carrier length mismatch"
printf '%s  %s\n' "$SYSTEM_CARRIER_SHA256" "$SYSTEM_CARRIER" |
  sha256sum -c - >/dev/null ||
  panic "immutable system carrier digest mismatch"

dd if="$SYSTEM_CARRIER" of="$SYSTEM_PAYLOAD" bs="$SYSTEM_PAYLOAD_BYTES" count=1 2>/dev/null ||
  panic "cannot read immutable system payload"
[ "$(wc -c <"$SYSTEM_PAYLOAD")" -eq "$SYSTEM_PAYLOAD_BYTES" ] ||
  panic "immutable system payload length mismatch"
printf '%s  %s\n' "$SYSTEM_PAYLOAD_SHA256" "$SYSTEM_PAYLOAD" |
  sha256sum -c - >/dev/null ||
  panic "immutable system payload digest mismatch"

tar -xzf "$SYSTEM_PAYLOAD" -C "$NEW_ROOT" --no-same-owner ||
  panic "cannot extract immutable system payload"
install -D -m 0755 /phonecode-guestd "$NEW_ROOT/usr/local/bin/phonecode-guestd" ||
  panic "cannot install guest daemon"

mkdir -p "$NEW_ROOT/dev" "$NEW_ROOT/proc" "$NEW_ROOT/sys" "$NEW_ROOT/workspace"
mount -t tmpfs -o size=128m,nosuid,nodev tmpfs "$NEW_ROOT/workspace" ||
  panic "cannot mount ephemeral workspace"

CONTROL_PORT=
for name_file in /sys/class/virtio-ports/*/name; do
  [ -f "$name_file" ] || continue
  if [ "$(cat "$name_file")" = "$CONTROL_PORT_NAME" ]; then
    CONTROL_PORT="/dev/$(basename "$(dirname "$name_file")")"
    break
  fi
done
[ -c "$CONTROL_PORT" ] || panic "dedicated control port is absent"

mount --move /dev "$NEW_ROOT/dev" || panic "cannot move devtmpfs"
mount --move /proc "$NEW_ROOT/proc" || panic "cannot move proc"
mount --move /sys "$NEW_ROOT/sys" || panic "cannot move sysfs"

exec 3<>"$NEW_ROOT$CONTROL_PORT" || panic "cannot open dedicated control port"
exec chroot "$NEW_ROOT" /usr/local/bin/phonecode-guestd \
  <&3 >&3 2>"$NEW_ROOT/dev/console" ||
  panic "guest daemon exited"
