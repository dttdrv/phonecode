+static void android_disable_pointer_tags(void)
+{
+    if (android_get_device_api_level() >= 31) {
+        mallopt(M_BIONIC_SET_HEAP_TAGGING_LEVEL, M_HEAP_TAGGING_LEVEL_NONE);
+        return;
+    }
+
+    void *libc = dlopen("libc.so", RTLD_LAZY | RTLD_LOCAL);
+    if (libc) {
+        bool (*android_mallopt)(int, void *, size_t) =
+            dlsym(libc, "android_mallopt");
+        if (android_mallopt) {
+            int tagging_level = 0;
+            android_mallopt(8, &tagging_level, sizeof(tagging_level));
+        }
+        dlclose(libc);
+    }
+}
+#else
+static void android_disable_pointer_tags(void)
+{
+}
+#endif
 
